# Keep ML source modules and lightweight metadata under backend/ml/models.
# Large trained artifacts remain ignored by their file extensions above.
!/backend/ml/models/
/backend/ml/models/*
!/backend/ml/models/component02/
/backend/ml/models/component02/*
!/backend/ml/models/component02/expected_yield_prediction/
!/backend/ml/models/component02/expected_yield_prediction/**/

