# Optional Export Advisor settings. With an API key, defaults to OpenAI and gpt-4o-mini.
# Without an API key, defaults to local Ollama at http://localhost:11434/v1 using llama3.1.
# Neon PostgreSQL URL for auth/users/sessions. If unset, SQLite is used locally.
DATABASE_URL=


# Optional JWT secret for code that uses JWTs; the current login flow does not use JWT.
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
LLM_API_KEY=

# For local Ollama, start a model first and use these defaults:
LLM_API_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1


# Google OAuth (the callback must exactly match the URI registered in Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# First-run Super Admin. Set the requested password in the untracked backend/.env;
# it is stored in SQLite as a scrypt hash. The bootstrap runs only until created.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Generate once with Fernet.generate_key() and keep this stable and secret.
# Existing authenticator secrets cannot be decrypted if this key is lost.
TOTP_ENCRYPTION_KEY=

# Set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
# Optional SQLite override for auth data, even when DATABASE_URL is set.
# Defaults to backend/data/rbac.sqlite3 when DATABASE_URL is unset.
# RBAC_DATABASE_PATH=
